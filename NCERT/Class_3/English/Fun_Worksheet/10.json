                    "items": [
                        {
                            "item_id": "Q1_1",
                            "sentence": "I carry ___ (a / an) umbrella in my bag when it rains.",
                            "answer": "an"
                        },
                        {
                            "item_id": "Q1_2",
                            "sentence": "The little cat is sleeping ___ (under / between) the table.",
                            "answer": "under"
                        },
                        {
                            "item_id": "Q1_3",
                            "sentence": "I like apples, ___ (but / so) I do not like sour grapes.",
                            "answer": "but"
                        },
                        {
                            "item_id": "Q1_4",
                            "sentence": "Yesterday, we ___ (go / went) to the zoo with our teacher.",
                            "answer": "went"
                        },
                        {
                            "item_id": "Q1_5",
                            "sentence": "Riya is sitting ___ (between / on) Rohan and Amit.",
                            "answer": "between"
                        }
