                                "The bright yellow sun",
                                "bright yellow"
                            ],
                            "answer": "The bright yellow sun"
                        },
                        {
                            "item_id": "Q2_2",
                            "question": "What type of pronoun is the bold word: 'The red bag is **mine**.'",
                            "options": [
                                "Personal Pronoun",
                                "Possessive Pronoun",
                                "Reflexive Pronoun"
                            ],
                            "answer": "Possessive Pronoun"
                        },
                        {
                            "item_id": "Q2_3",
                            "question": "Choose the correct Adjective of Comparison: 'Mount Everest is the ___ mountain in the world.'",
