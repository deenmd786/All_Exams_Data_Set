                                "Action Verb"
                            ],
                            "answer": "Helping Verb"
                        },
                        {
                            "item_id": "Q2_5",
                            "question": "Which part is the Predicate in this sentence: 'Birds fly in the sky.'",
                            "options": [
                                "Birds",
                                "fly in the sky",
                                "in the sky"
                            ],
                            "answer": "fly in the sky"
                        },
                        {
                            "item_id": "Q2_6",
                            "question": "What type of pronoun is the bold word: 'He baked the cake **himself**.'",
                            "options": [
