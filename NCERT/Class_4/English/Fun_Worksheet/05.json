                    "instruction": "Fill in the blanks with the correct option for Subject-Verb Agreement, Tenses, Prepositions, or Articles:",
                    "marks": 8,
                    "items": [
                        {
                            "item_id": "Q1_1",
                            "sentence": "My dog and my cat ___ (is / are) playing in the garden.",
                            "options": [
                                "is",
                                "are"
                            ],
                            "answer": "are"
                        },
                        {
                            "item_id": "Q1_2",
                            "sentence": "She ___ (was reading / readed) a book when the phone rang.",
                            "options": [
                                "was reading",
                                "readed"
                            ],
                            "answer": "was reading"
                        },
                        {
                            "item_id": "Q1_3",
                            "sentence": "The brave firefighter ran ___ (towards / on) the burning building.",
                            "options": [
                                "towards",
                                "on"
                            ],
                            "answer": "towards"
                        },
                        {
                            "item_id": "Q1_4",
                            "sentence": "I saw ___ (a / an) eagle flying high in the sky.",
                            "options": [
                                "a",
                                "an"
                            ],
                            "answer": "an"
                        },
                        {
                            "item_id": "Q1_5",
                            "sentence": "The children ___ (has / have) finished their homework.",
                            "options": [
                                "has",
                                "have"
                            ],
                            "answer": "have"
                        },
                        {
                            "item_id": "Q1_6",
                            "sentence": "Look at ___ (these / this) beautiful flowers over there.",
                            "options": [
                                "these",
                                "this"
                            ],
                            "answer": "these"
                        },
                        {
                            "item_id": "Q1_7",
                            "sentence": "He jumped ___ (into / at) the swimming pool to cool off.",
                            "options": [
                                "into",
                                "at"
                            ],
                            "answer": "into"
                        },
                        {
                            "item_id": "Q1_8",
                            "sentence": "Tomorrow, we ___ (will go / went) to the museum.",
                            "options": [
                                "will go",
                                "went"
                            ],
                            "answer": "will go"
