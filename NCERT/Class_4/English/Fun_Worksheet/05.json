                                "Reflexive Pronoun",
                                "Demonstrative Pronoun"
                            ],
                            "answer": "Reflexive Pronoun"
                        },
                        {
                            "item_id": "Q2_7",
                            "question": "Choose the correct Conjunction for the result: 'It was raining heavily, ___ we stayed inside.'",
                            "options": [
                                "because",
                                "but",
                                "so"
                            ],
                            "answer": "so"
                        }
                    ]
