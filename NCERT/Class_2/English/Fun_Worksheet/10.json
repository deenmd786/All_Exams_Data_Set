                                "Tigers in a cave"
                            ],
                            "answer": "A flock of sheep"
                        },
                        {
                            "item_id": "Q7.3",
                            "text": "In 'The Crow', how was the crow feeling at the beginning of the story?",
                            "options": [
                                "Happy",
                                "Thirsty",
                                "Sleepy"
                            ],
                            "answer": "Thirsty"
                        },
                        {
                            "item_id": "Q7.4",
                            "text": "In 'We are all Indians', what unites people from different places?",
                            "options": [
                                "Our clothes",
                                "Our country India",
                                "Our bags"
                            ],
                            "answer": "Our country India"
                        },
                        {
                            "item_id": "Q7.5",
                            "text": "In 'My Bicycle', what helps the bicycle move forward?",
                            "options": [
                                "The bell",
                                "The seat",
                                "The pedals"
                            ],
                            "answer": "The pedals"
                        }
                    ]
                },
