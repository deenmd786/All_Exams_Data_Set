                    "question_id": "Q1",
                    "type": "fill_in_the_blanks",
                    "instruction": "Fill in the blanks with correct Prepositions (in / on / under / near).",
                    "marks": 5,
                    "items": [
                        {
                            "item_id": "Q1.1",
                            "text": "The cat is sleeping ___ the bed.",
                            "answer": "under"
                        },
                        {
                            "item_id": "Q1.2",
                            "text": "The books are kept ___ the bag.",
                            "answer": "in"
                        },
                        {
                            "item_id": "Q1.3",
                            "text": "The beautiful vase is ___ the table.",
                            "answer": "on"
                        },
                        {
                            "item_id": "Q1.4",
                            "text": "The boy is standing ___ the tree.",
                            "answer": "near"
                        },
                        {
                            "item_id": "Q1.5",
                            "text": "The clock is hanging ___ the wall.",
                            "answer": "on"
                        }
                    ]
                },
