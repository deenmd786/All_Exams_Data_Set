                    "items": [
                        {
                            "item_id": "Q1.1",
                            "text": "I ___ reading my favorite storybook.",
                            "answer": "am"
                        },
                        {
                            "item_id": "Q1.2",
                            "text": "The sky ___ very clear today.",
                            "answer": "is"
                        },
                        {
                            "item_id": "Q1.3",
                            "text": "They ___ playing hide and seek.",
                            "answer": "are"
                        },
                        {
                            "item_id": "Q1.4",
                            "text": "She ___ a very kind girl.",
                            "answer": "is"
                        },
                        {
                            "item_id": "Q1.5",
                            "text": "We ___ going to the zoo tomorrow.",
                            "answer": "are"
