                    "instruction": "Fill in the blanks with correct Prepositions (in / on / under).",
                    "marks": 5,
                    "items": [
                        {
                            "item_id": "Q3.1",
                            "text": "The book is kept ___ the desk.",
                            "answer": "on"
                        },
                        {
                            "item_id": "Q3.2",
                            "text": "The little fish swims ___ the pond.",
                            "answer": "in"
                        },
                        {
                            "item_id": "Q3.3",
                            "text": "The dog is sleeping ___ the chair.",
                            "answer": "under"
                        },
                        {
                            "item_id": "Q3.4",
                            "text": "There are many apples ___ the basket.",
                            "answer": "in"
                        },
                        {
                            "item_id": "Q3.5",
                            "text": "The wall clock is hanging ___ the wall.",
                            "answer": "on"
