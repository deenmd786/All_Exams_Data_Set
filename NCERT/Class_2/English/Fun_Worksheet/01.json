                            "item_id": "Q2.2",
                            "text": "The fish swims ___ the water.",
                            "answer": "in"
                        },
                        {
                            "item_id": "Q2.3",
                            "text": "The cat is sleeping ___ the bed.",
                            "answer": "under"
                        },
                        {
                            "item_id": "Q2.4",
                            "text": "The bird is sitting ___ the branch.",
                            "answer": "on"
                        },
                        {
                            "item_id": "Q2.5",
                            "text": "My pencils are ___ the pencil box.",
                            "answer": "in"
