                                "It",
                                "He"
                            ],
                            "answer": "He"
                        },
                        {
                            "item_id": "Q3.4",
                            "text": "Identify the Noun in the sentence: 'I love my school.'",
                            "options": [
                                "love",
                                "my",
                                "school"
                            ],
                            "answer": "school"
                        },
                        {
