                    "items": [
                        {
                            "item_id": "Q7.1",
                            "text": "In 'The Crow', why was the crow looking for water?",
                            "options": [
                                "Because he was hungry",
                                "Because he was thirsty",
                                "Because he wanted to bathe"
                            ],
                            "answer": "Because he was thirsty"
                        },
                        {
                            "item_id": "Q7.2",
                            "text": "In 'The Smart Monkey', what did the monkey drop into the river for the crocodile?",
                            "options": [
                                "Leaves",
                                "Stones",
                                "Sweet fruits"
                            ],
                            "answer": "Sweet fruits"
                        },
                        {
                            "item_id": "Q7.3",
                            "text": "In 'My Bicycle', what do you do to make the bicycle move?",
                            "options": [
                                "Push the bell",
                                "Pedal",
                                "Honk the horn"
                            ],
                            "answer": "Pedal"
                        },
                        {
                            "item_id": "Q7.4",
                            "text": "In 'We are all Indians', what are we all proud of?",
                            "options": [
                                "Our toys",
                                "Our country",
                                "Our bags"
                            ],
                            "answer": "Our country"
                        },
                        {
                            "item_id": "Q7.5",
                            "text": "In 'It is Fun', what is fun to do?",
                            "options": [
                                "To act like animals",
                                "To cry loudly",
                                "To sit still"
                            ],
                            "answer": "To act like animals"
                        }
                    ]
                },
