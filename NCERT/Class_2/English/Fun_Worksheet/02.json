                        {
                            "item_id": "Q1.3",
                            "text": "I ___ very happy to see my friends.",
                            "answer": "was"
                        },
                        {
                            "item_id": "Q1.4",
                            "text": "We ___ walking to the market.",
                            "answer": "were"
