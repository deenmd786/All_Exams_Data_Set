                {
                    "question_id": "Q3",
                    "type": "multiple_choice",
                    "instruction": "Choose the correct Action Word (Verb) or Describing Word (Adjective).",
                    "marks": 5,
                    "items": [
                        {
                            "item_id": "Q3.1",
                            "text": "Identify the action word in the sentence: 'The boy jumps high.'",
                            "options": [
                                "The",
                                "boy",
                                "jumps"
                            ],
                            "answer": "jumps"
                        },
                        {
                            "item_id": "Q3.2",
                            "text": "Identify the describing word in the sentence: 'She has a red dress.'",
                            "options": [
                                "She",
                                "red",
                                "dress"
                            ],
                            "answer": "red"
                        },
                        {
                            "item_id": "Q3.3",
                            "text": "Which word is an action word: 'We sing a song.'",
                            "options": [
                                "We",
                                "sing",
                                "song"
                            ],
                            "answer": "sing"
                        },
                        {
                            "item_id": "Q3.4",
                            "text": "Which word is a describing word: 'Look at the tall tree.'",
                            "options": [
                                "Look",
                                "tall",
                                "tree"
                            ],
                            "answer": "tall"
                        },
                        {
                            "item_id": "Q3.5",
                            "text": "Identify the action word in the sentence: 'Birds fly in the sky.'",
                            "options": [
                                "Birds",
                                "fly",
                                "sky"
                            ],
                            "answer": "fly"
                        }
                    ]
                }
