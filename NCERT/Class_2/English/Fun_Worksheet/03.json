                    "instruction": "Fill in the blanks with correct Pronouns (He / She / It / We / They).",
                    "marks": 5,
                    "items": [
                        {
                            "item_id": "Q1.1",
                            "text": "Ravi is a good boy. ___ likes to play cricket.",
                            "answer": "He"
                        },
                        {
                            "item_id": "Q1.2",
                            "text": "Sita is my friend. ___ is reading a book.",
                            "answer": "She"
                        },
                        {
                            "item_id": "Q1.3",
                            "text": "Look at the dog. ___ is barking loudly.",
                            "answer": "It"
                        },
                        {
                            "item_id": "Q1.4",
                            "text": "My family and I went to the park. ___ had a lot of fun.",
                            "answer": "We"
                        },
                        {
                            "item_id": "Q1.5",
                            "text": "The children are in the playground. ___ are sliding.",
                            "answer": "They"
